# Production database settings
# Neon provides a PostgreSQL connection string from the Connect button.
# Convert it to the JDBC form used by Spring Boot:
# jdbc:postgresql://HOST/DBNAME?sslmode=require&channelBinding=require
DATABASE_URL=jdbc:postgresql://HOST/DBNAME?sslmode=require&channelBinding=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=CHANGE_ME

# Application
PORT=8092
DDL_AUTO=update

# Optional connection-pool tuning for a small/free database plan
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=0
DB_CONNECTION_TIMEOUT_MS=10000
DB_VALIDATION_TIMEOUT_MS=5000
